# Single source of truth for what gets built.
# A release tag must be v${LIBJXL_VERSION}-${PACKAGE_REVISION}.
LIBJXL_VERSION=0.12.0
# Commit that the upstream tag v${LIBJXL_VERSION} must point to (tamper check).
LIBJXL_COMMIT=a7a9c787341cf703dede03c2009fa460cae5e5df
# Bump when re-releasing the same libjxl version with packaging/build changes.
PACKAGE_REVISION=2
EMSDK_VERSION=6.0.13
